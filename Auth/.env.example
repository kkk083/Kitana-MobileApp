# ============================================================================
# Fichier de configuration des variables d'environnement
# Copiez ce fichier en .env et modifiez les valeurs selon votre configuration
# ============================================================================

# Configuration de la base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kintana_project_GL
DB_USER=postgres
DB_PASSWORD=

# Configuration de sécurité
SECRET_KEY=votre_cle_secrete_changez_moi_en_production
JWT_SECRET_KEY=votre_cle_jwt_changez_moi_en_production

# Configuration de l'application
FLASK_ENV=development
FLASK_DEBUG=True

# Configuration CORS (origines autorisées)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Configuration Email (pour l'envoi des tokens de réinitialisation)
# À configurer si vous souhaitez envoyer des emails réels
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=votre_email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_app

# Configuration de l'application
APP_NAME=Kintana Project API
APP_VERSION=1.0.0
